{
  "name": "memory",
  "displayName": "OpenBMC 知识助手",
  "description": "A cross-project engineering memory and context retrieval assistant for VS Code",
  "version": "0.3.24",
  "publisher": "xuqj-local",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "contextRecall.mcpServers",
        "label": "OpenBMC 知识助手"
      }
    ],
    "commands": [
      {
        "command": "contextRecall.startChat",
        "title": "OpenBMC 知识助手: Start Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "contextRecall.openDashboard",
        "title": "OpenBMC 知识助手: Open Data Overview",
        "icon": "$(graph)"
      },
      {
        "command": "contextRecall.refreshSidebar",
        "title": "OpenBMC 知识助手: Refresh Overview",
        "icon": "$(refresh)"
      },
      {
        "command": "contextRecall.organizeCopilotSessions",
        "title": "OpenBMC 知识助手: Organize All Copilot Sessions",
        "icon": "$(sparkle)"
      },
      {
        "command": "contextRecall.syncService",
        "title": "OpenBMC 知识助手: Sync Local Data To Layered Service",
        "icon": "$(sync)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextRecall",
          "title": "OpenBMC 知识助手",
          "icon": "media/activitybar-probe.png"
        }
      ]
    },
    "views": {
      "contextRecall": [
        {
          "type": "webview",
          "id": "contextRecall.sidebar",
          "name": "Data Overview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "contextRecall.refreshSidebar",
          "when": "view == contextRecall.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "contextRecall.openDashboard",
          "when": "view == contextRecall.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "contextRecall.organizeCopilotSessions",
          "when": "view == contextRecall.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "contextRecall.syncService",
          "when": "view == contextRecall.sidebar",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "OpenBMC 知识助手",
      "properties": {
        "contextRecall.backend": {
          "type": "string",
          "enum": [
            "auto",
            "service",
            "local"
          ],
          "default": "auto",
          "description": "Use the layered service when available, require it, or use only the embedded local fallback."
        },
        "contextRecall.serviceUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Base URL of the independent companion service."
        },
        "knowledgeAgent.backend": {
          "type": "string",
          "enum": [
            "auto",
            "service",
            "local"
          ],
          "default": "auto",
          "deprecationMessage": "已更名为 contextRecall.backend（单名制迁移），旧键仍可读但不再维护。",
          "description": "[已弃用] 旧键，请改用 contextRecall.backend。"
        },
        "knowledgeAgent.serviceUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "deprecationMessage": "已更名为 contextRecall.serviceUrl（单名制迁移），旧键仍可读但不再维护。",
          "description": "[已弃用] 旧键，请改用 contextRecall.serviceUrl。"
        }
      }
    },
    "chatParticipants": [
      {
        "id": "contextRecall.chat",
        "name": "openbmc",
        "fullName": "OpenBMC 知识助手",
        "description": "A cross-project engineering memory assistant with persistent sessions, hybrid recall, and evidence-linked knowledge.",
        "isSticky": true,
        "commands": [
          {
            "name": "overview",
            "description": "Open the data overview"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "test:mcp": "npm run package && node scripts/test-mcp.mjs",
    "test:continuity": "npm run compile-tests && node scripts/evaluate-session-continuity.mjs",

    "test:retrieval": "npm run compile-tests && node scripts/evaluate-retrieval.mjs",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.103.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pdfjs-dist": "^6.3.289",
    "zod": "^4.5.4"
  }
}
